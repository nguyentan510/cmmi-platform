# CMMI Platform Agent Toolkit Configuration

# Base URL of your CMMI Platform instance (e.g. http://localhost:8000 or https://your-cmmi.onrender.com)
CMMI_BASE_URL=http://localhost:8000

# Your CMMI API Key (starts with cmmi_live_...) with contents:read/write and media:read/write scopes
CMMI_API_KEY=cmmi_live_your_api_key_here

{
  "name": "cmmi-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate:api": "openapi-typescript ../shared/openapi.json -o src/types/api.d.ts",
    "check:api": "node scripts/check-contract.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "openapi-fetch": "^0.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.8.0",
    "prettier": "^3.9.10",
    "sass": "^1.86.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}

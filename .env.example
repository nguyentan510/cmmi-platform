# Copy to .env and replace placeholders before connecting to cloud services.
ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://cmmi:replace-password@your-pooler.neon.tech/cmmi?sslmode=require
DATABASE_DIRECT_URL=postgresql+asyncpg://cmmi:replace-password@your-direct.neon.tech/cmmi?sslmode=require
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["https://cms.example.com"]
SCHEDULER_ENABLED=true
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-r2-access-key
R2_SECRET_ACCESS_KEY=replace-r2-secret-key
R2_BUCKET_NAME=cmmi-media
R2_PUBLIC_DOMAIN=https://media.example.com
CLOUDFLARE_TUNNEL_TOKEN=replace-cloudflare-tunnel-token
